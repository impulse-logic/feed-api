# PostgreSQL database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=sliq
# disable | require | verify-full  (use require/verify-full for remote/managed databases)
DB_SSLMODE=disable
# true = let GORM create/update tables on startup. Keep false if another app owns the schema.
DB_AUTO_MIGRATE=false

# Server settings
SERVER_PORT=8080
# debug | release  (use release in production)
GIN_MODE=debug

# Azure Service Bus (see docs/SERVICE_BUS.md)
SERVICE_BUS_CONNECTION_STRING="servicebuskey"
# Only used when SERVICE_BUS_CONNECTION_STRING is empty (Azure AD login: az login / managed identity)
SERVICE_BUS_NAMESPACE=""
# Queue names the API may read, comma-separated (e.g. vendor,product)
SERVICE_BUS_ENTITY="vendor,product-hierarchies,products,product-upcs,boh,deliveries,stocktake,product-variants,pos"
# Secret for the /queue admin endpoints, sent as the X-Admin-Token header. Generate: openssl rand -hex 32
QUEUE_ADMIN_TOKEN=
# Optional tuning for POST /queue/{name}/process (defaults shown)
QUEUE_WORKERS=8
QUEUE_BATCH_SIZE=100